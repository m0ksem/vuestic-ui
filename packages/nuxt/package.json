  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.3.0",
    "nuxt": "^4.3.0",
    "pathe": "^2.0.3",
    "vuestic-ui": "~1.10.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/vite-builder": "^4.3.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "eslint": "^8.53.0"
  }
