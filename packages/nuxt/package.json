{
  "name": "@vuestic/nuxt",
  "description": "Vuestic UI module for Nuxt 3",
  "keywords": [
    "vuesticui",
    "vuestic",
    "nuxt3",
    "nuxt",
    "vue"
  ],
  "version": "1.0.22",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/module.mjs",
